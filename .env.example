# Copy to .env and fill values for real OpenAI-compatible API calls.
# Keep MEMORY_TOOL_PLANNER_OFFLINE=1 for local smoke tests without network access.

MEMORY_TOOL_PLANNER_OFFLINE=1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional per-capability credentials/endpoints. If unset, they fall back to
# OPENAI_API_KEY and OPENAI_BASE_URL.
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=

OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_INPUT_FORMAT=array
OPENAI_EMBEDDING_MAX_CHARS=0
OPENAI_TIMEOUT_SECONDS=60

# Optional role-specific endpoints.
OPENAI_TEACHER_API_KEY=
OPENAI_TEACHER_BASE_URL=
OPENAI_TEACHER_MODEL=

OPENAI_ANSWER_API_KEY=
OPENAI_ANSWER_BASE_URL=
OPENAI_ANSWER_MODEL=

OPENAI_JUDGE_API_KEY=
OPENAI_JUDGE_BASE_URL=
OPENAI_JUDGE_MODEL=

MEMORY_TOOL_PLANNER_DATA_ROOT=
LOCOMO_DATA_ROOT=
PERSONAMEM_DATA_ROOT=

PLANNER_MODEL_PATH=
ANSWER_MODEL_PATH=
JUDGE_MODEL_PATH=
TOKENIZER_NAME_OR_PATH=
